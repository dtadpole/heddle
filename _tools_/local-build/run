#!/bin/sh
# Run a cargo command inside one of this Mac's build slots.
#
#   _tools_/local-build/run test -p heddle-config
#   _tools_/local-build/run build --release
#   _tools_/local-build/run status
#
# Each slot is a directory under $LOCAL_BUILD_SLOT_ROOT. A slot directory is created
# atomically with mkdir and removed when the command ends, so two seats never build at
# once in the same slot. A slot whose owner process is gone, or whose stamp is older
# than an hour, is reclaimed. The command runs from the caller's working directory, so
# run it from inside your own worktree.
set -eu

SLOTS=${LOCAL_BUILD_SLOTS:-3}
JOBS=${LOCAL_BUILD_JOBS:-3}
ROOT=${LOCAL_BUILD_SLOT_ROOT:-$HOME/.hd-build-slots}
WAIT=${LOCAL_BUILD_WAIT_SECONDS:-1800}
STALE=${LOCAL_BUILD_STALE_SECONDS:-3600}
CARGO=${CARGO:-$HOME/.cargo/bin/cargo}

# The profile settings keep target directories small: this Mac has one disk shared by
# every seat, and an unreleased binary never needs debug symbols.
CARGO_PROFILE_DEV_DEBUG=${CARGO_PROFILE_DEV_DEBUG:-0}
CARGO_PROFILE_RELEASE_DEBUG=${CARGO_PROFILE_RELEASE_DEBUG:-0}
CARGO_INCREMENTAL=${CARGO_INCREMENTAL:-0}
export CARGO_PROFILE_DEV_DEBUG CARGO_PROFILE_RELEASE_DEBUG CARGO_INCREMENTAL

stamp() { date +%s; }

usage() {
    echo "usage: $0 <cargo args...> | $0 status" >&2
    echo "  LOCAL_BUILD_SLOTS=$SLOTS LOCAL_BUILD_JOBS=$JOBS LOCAL_BUILD_SLOT_ROOT=$ROOT" >&2
    exit 64
}

mkdir -p "$ROOT"

# The coordinator can cut the Mac to fewer usable slots in one write:
#   echo 2 > $LOCAL_BUILD_SLOT_ROOT/cap
# The default is every slot. A cap that is not a whole number between 1 and $SLOTS is
# ignored with a warning rather than silently stopping work.
CAP=$SLOTS
CAP_SOURCE=default
read_cap() {
    capfile="$ROOT/cap"
    CAP=$SLOTS
    CAP_SOURCE=default
    if [ ! -f "$capfile" ]; then
        return 0
    fi
    cap_raw=
    read -r cap_raw < "$capfile" 2>/dev/null || true
    cap_raw=$(printf '%s' "${cap_raw:-}" | tr -d '[:space:]')
    case "$cap_raw" in
        '' | *[!0-9]*) ;;
        *)
            if [ "$cap_raw" -ge 1 ] && [ "$cap_raw" -le "$SLOTS" ]; then
                CAP=$cap_raw
                CAP_SOURCE=file
                return 0
            fi
            ;;
    esac
    CAP_SOURCE=ignored
    echo "local-build: ignoring $capfile: it must hold a whole number from 1 to $SLOTS" >&2
}
read_cap

# An owner file is "<pid> <epoch> <cargo> <cwd>": the run shell, when it took the slot,
# the cargo process (0 until it starts) and the caller's directory. It is rewritten once
# cargo starts, so a killed shell whose cargo still builds is a busy slot, not a free
# one. The cargo pid is last but one, so a directory with a space stays in one field.
# The o_ names are kept apart from $cargo_pid on purpose: a function that read an owner
# file must never overwrite the pid this shell is waiting for.
owner_line() {
    if [ -f "$1/owner" ]; then
        cat "$1/owner" 2>/dev/null || true
    fi
}
owner_fields() {
    o_pid=0; o_ts=0; o_cargo=0; o_cwd=
    read -r o_pid o_ts o_cargo o_cwd < "$1/owner" 2>/dev/null || true
    # An owner file written before the cargo pid was recorded has three fields:
    # "<pid> <epoch> <cwd>". Read the third as the directory rather than as a pid.
    case "${o_cargo:-}" in
        '' | *[!0-9]*) o_cwd=${o_cargo:-}; o_cargo=0 ;;
    esac
}
owner_alive() {
    if [ -n "${o_cargo:-}" ] && [ "$o_cargo" != "0" ] && kill -0 "$o_cargo" 2>/dev/null; then
        return 0
    fi
    if [ -n "${o_pid:-}" ] && [ "$o_pid" != "0" ] && kill -0 "$o_pid" 2>/dev/null; then
        return 0
    fi
    return 1
}

# A dead slot is one no process holds: its owner pid and its cargo are both gone. An
# ownerless directory is the microsecond between mkdir and the owner write; it gets a
# short grace, then counts as dead.
is_dead() {
    d=$1
    [ -d "$d" ] || return 1
    if [ ! -f "$d/owner" ]; then
        sleep 0.2
        [ -f "$d/owner" ] || return 0
    fi
    owner_fields "$d"
    if owner_alive; then
        return 1
    fi
    return 0
}

# An old slot is one whose stamp is past $STALE, whether or not its process lives: a
# build that ran for an hour is not a build this Mac should keep waiting for.
is_old() {
    d=$1
    [ -f "$d/owner" ] || return 1
    owner_fields "$d"
    now=$(stamp)
    if [ $((now - o_ts)) -gt "$STALE" ]; then
        return 0
    fi
    return 1
}

# Move a slot directory out of the way in one atomic rename, then delete it only if its
# owner line is exactly the one judged. The rename means two reclaimers cannot both
# remove the same directory; the re-read means a slot re-acquired in between is put back
# instead of deleted.
reclaim() {
    d=$1
    before=$(owner_line "$d")
    # The trash sits beside the directory (a second argument names its parent), so the
    # rename never crosses a volume and stays atomic.
    t=$(mktemp -d "${2:-$ROOT}/.trash.XXXXXX") || return 1
    if ! mv "$d" "$t/slot" 2>/dev/null; then
        rm -rf "$t" 2>/dev/null || true
        return 1
    fi
    after=$(owner_line "$t/slot")
    if [ "$after" != "$before" ]; then
        # Someone re-acquired the slot between the check and the rename. Put the live
        # slot back; if its name is taken, leave it in the trash undeleted and say so.
        if ! mv "$t/slot" "$d" 2>/dev/null; then
            echo "local-build: kept a live slot in $t/slot; remove it by hand" >&2
            return 1
        fi
        rm -rf "$t" 2>/dev/null || true
        return 1
    fi
    rm -rf "$t" 2>/dev/null || true
    return 0
}

take() {
    i=$1
    d="$ROOT/slot-$i"
    mkdir "$d" 2>/dev/null || return 1
    if ! printf '%s %s 0 %s\n' "$$" "$(stamp)" "$PWD" > "$d/owner" 2>/dev/null; then
        rm -rf "$d" 2>/dev/null || true
        return 1
    fi
    SLOT=$i
    return 0
}

# Clean up after killed owners first, so a dead slot never lingers; then take a free
# one; only when every slot is busy, break an hour-old stamp.
try_acquire() {
    i=0
    while [ "$i" -lt "$SLOTS" ]; do
        d="$ROOT/slot-$i"
        if is_dead "$d"; then
            reclaim "$d" || true
        fi
        i=$((i + 1))
    done
    i=0
    while [ "$i" -lt "$CAP" ]; do
        if take "$i"; then
            return 0
        fi
        i=$((i + 1))
    done
    i=0
    while [ "$i" -lt "$CAP" ]; do
        d="$ROOT/slot-$i"
        if is_old "$d"; then
            if reclaim "$d"; then
                if take "$i"; then
                    return 0
                fi
            fi
        fi
        i=$((i + 1))
    done
    return 1
}

show_status() {
    printf 'root: %s\nslots: %s  jobs: %s\n' "$ROOT" "$SLOTS" "$JOBS"
    case "$CAP_SOURCE" in
        file) printf 'cap: %s of %s slots (set by %s/cap)\n' "$CAP" "$SLOTS" "$ROOT" ;;
        ignored) printf 'cap: %s of %s slots (cap file ignored; see the warning)\n' "$CAP" "$SLOTS" ;;
        *) printf 'cap: %s of %s slots (default; no cap file)\n' "$CAP" "$SLOTS" ;;
    esac
    busy=0; stale=0; free=0; i=0
    while [ "$i" -lt "$SLOTS" ]; do
        d="$ROOT/slot-$i"
        if [ ! -d "$d" ]; then
            printf 'slot %s: free%s\n' "$i" "$([ "$i" -ge "$CAP" ] && echo ' (beyond cap)')"
            free=$((free + 1))
        elif [ ! -f "$d/owner" ]; then
            printf 'slot %s: unclaimed (no owner file)\n' "$i"
            stale=$((stale + 1))
        else
            owner_fields "$d"
            now=$(stamp)
            age=$((now - o_ts))
            if owner_alive && [ "$age" -le "$STALE" ]; then
                printf 'slot %s: busy pid=%s cargo=%s age=%ss cwd=%s%s\n' "$i" "$o_pid" "$o_cargo" "$age" "${o_cwd:-?}" "$([ "$i" -ge "$CAP" ] && echo ' (beyond cap)')"
                busy=$((busy + 1))
            else
                printf 'slot %s: stale pid=%s cargo=%s age=%ss cwd=%s%s\n' "$i" "$o_pid" "$o_cargo" "$age" "${o_cwd:-?}" "$([ "$i" -ge "$CAP" ] && echo ' (beyond cap)')"
                stale=$((stale + 1))
            fi
        fi
        i=$((i + 1))
    done
    for t in "$ROOT"/.trash.*; do
        if [ -d "$t" ]; then
            printf 'trash: %s\n' "$t"
        fi
    done
    printf 'summary: busy=%s stale=%s free=%s\n' "$busy" "$stale" "$free"
    if [ "$stale" -eq 0 ]; then
        return 0
    fi
    return 1
}

if [ $# -eq 0 ]; then
    usage
fi
if [ "$1" = "status" ]; then
    if [ $# -ne 1 ]; then
        usage
    fi
    show_status
    exit $?
fi

if [ ! -x "$CARGO" ]; then
    echo "local-build: cargo not found at $CARGO (set CARGO or install the toolchain)" >&2
    exit 127
fi

# A caller that chose its own job count keeps it; otherwise the slot's cap applies.
has_jobs=0
for arg in "$@"; do
    case "$arg" in
        --) break ;;
        -j | --jobs | -j[0-9]* | --jobs=*) has_jobs=1 ;;
    esac
done

deadline=$(( $(stamp) + WAIT ))
while ! try_acquire; do
    if [ "$(stamp)" -ge "$deadline" ]; then
        echo "local-build: no free slot within ${WAIT}s; try again later or raise LOCAL_BUILD_WAIT_SECONDS" >&2
        exit 75
    fi
    sleep 3
done

# Only remove the slot while it still names this process as its owner. A slot can be
# reclaimed and re-acquired while a command runs (an hour-old stamp, a reused pid), and
# this process must never delete the new occupant's directory.
cleanup() {
    if [ -n "${TREE_LOCK:-}" ] && [ -f "$TREE_LOCK/owner" ]; then
        l_pid=0
        read -r l_pid l_rest < "$TREE_LOCK/owner" 2>/dev/null || true
        if [ "${l_pid:-}" = "$$" ]; then
            rm -rf "$TREE_LOCK" 2>/dev/null || true
        fi
    fi
    d="$ROOT/slot-${SLOT:-none}"
    [ -f "$d/owner" ] || return 0
    owner_fields "$d"
    if [ "${o_pid:-}" = "$$" ]; then
        rm -rf "$d" 2>/dev/null || true
    fi
}
trap cleanup EXIT

echo "local-build: slot $SLOT, cap $CAP of $SLOTS, jobs $([ "$has_jobs" = 1 ] && echo caller || echo "$JOBS"), cwd $PWD" >&2

# A seat's worktrees may share one CARGO_TARGET_DIR to save the disk. Cargo does not key a
# workspace crate by its checkout path, so a tree whose sources are older than another
# tree's build there looks fresh, and its binary is the other tree's code. For a compiling
# command into a CARGO_TARGET_DIR, the runner therefore holds the target's lock for the
# whole command, and when another tree (or an unknown one) built there last, touches this
# tree's Rust sources first so cargo rebuilds them (shared-target.md).
TREE_LOCK=
guard_shared_target() {
    [ -n "${CARGO_TARGET_DIR:-}" ] || return 0
    [ "${LOCAL_BUILD_TREE_GUARD:-1}" != 0 ] || return 0
    case "${1-}" in
        build | check | test | run | bench | doc | clippy | rustc | install | fix) ;;
        *) return 0 ;;
    esac
    # Cargo reads a relative target from the caller's directory; spell it out for the messages.
    case "$CARGO_TARGET_DIR" in
        /*) td=$CARGO_TARGET_DIR ;;
        *) td="$PWD/$CARGO_TARGET_DIR" ;;
    esac
    tree=$(git rev-parse --show-toplevel 2>/dev/null) || tree=$PWD
    mkdir -p "$td"
    lock="$td/.local-build-lock"
    lock_deadline=$(( $(stamp) + WAIT ))
    said=0
    while ! mkdir "$lock" 2>/dev/null; do
        if is_dead "$lock"; then
            reclaim "$lock" "$td" || true
            continue
        fi
        if [ "$said" = 0 ]; then
            echo "local-build: waiting for the build in ${o_cwd:-another tree} to finish with $td" >&2
            said=1
        fi
        if [ "$(stamp)" -ge "$lock_deadline" ]; then
            echo "local-build: $td stayed locked by ${o_cwd:-another tree} for ${WAIT}s; try again later" >&2
            exit 75
        fi
        sleep 1
    done
    printf '%s %s 0 %s\n' "$$" "$(stamp)" "$tree" > "$lock/owner"
    TREE_LOCK=$lock
    last=
    if [ -f "$td/.local-build-tree" ]; then
        read -r last 2>/dev/null < "$td/.local-build-tree" || true
    fi
    if [ "$last" != "$tree" ]; then
        n=$(cd "$tree" && git ls-files -z -co --exclude-standard -- '*.rs' 2>/dev/null | tr -cd '\000' | wc -c | tr -d ' ')
        (cd "$tree" && git ls-files -z -co --exclude-standard -- '*.rs' 2>/dev/null | xargs -0 touch -c) || true
        echo "local-build: $td was last built from ${last:-an unrecorded tree}; touched $n Rust sources in $tree so cargo rebuilds them" >&2
        printf '%s\n' "$tree" > "$td/.local-build-tree"
    fi
}
guard_shared_target "$@"

if [ "$has_jobs" = 1 ]; then
    set -- "$@"
else
    # -j belongs after the subcommand: `cargo -j 3 build` works, but `cargo -j 3 --version`
    # is rejected, and `cargo fmt` takes no jobs at all. Inject only for the subcommands
    # that compile something.
    case "${1-}" in
        build | check | test | run | bench | doc | clippy | rustc | install | fix)
            sub=$1
            shift
            set -- "$sub" -j "$JOBS" "$@"
            ;;
    esac
fi

# Run cargo as a child rather than with exec, so the slot is released when the command
# ends and on a signal. A signal is forwarded to cargo and the shell keeps waiting, so
# the slot is never freed while cargo is still building.
"$CARGO" "$@" &
cargo_pid=$!
if [ -f "$ROOT/slot-$SLOT/owner" ]; then
    owner_fields "$ROOT/slot-$SLOT"
    printf '%s %s %s %s\n' "$$" "$o_ts" "$cargo_pid" "$PWD" > "$ROOT/slot-$SLOT/owner" 2>/dev/null || true
fi
# The target's lock records cargo too, so a killed shell whose cargo still writes the target
# keeps the lock until cargo exits.
if [ -n "$TREE_LOCK" ] && [ -f "$TREE_LOCK/owner" ]; then
    owner_fields "$TREE_LOCK"
    printf '%s %s %s %s\n' "$$" "$o_ts" "$cargo_pid" "$o_cwd" > "$TREE_LOCK/owner" 2>/dev/null || true
fi

forward() {
    kill "-$1" "$cargo_pid" 2>/dev/null || true
}
trap 'forward TERM' TERM
trap 'forward INT' INT
trap 'forward HUP' HUP

rc=0
while :; do
    rc=0
    wait "$cargo_pid" || rc=$?
    kill -0 "$cargo_pid" 2>/dev/null || break
done
# After a successful build, drop the superseded heddle artifacts it left in target/*/deps (deps-sweep.md).
# A failed or skipped sweep never changes the build's status.
if [ "$rc" = 0 ] && [ "${LOCAL_BUILD_DEPS_SWEEP:-1}" != 0 ]; then
    node "$(dirname "$0")/deps-sweep.mjs" --quiet --after-build -- "$@" >&2 || true
fi
exit "$rc"
