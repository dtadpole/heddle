{
  "name": "@dtadpole/heddle",
  "version": "0.0.1",
  "description": "A harness and agent framework built on Cordis, in TypeScript.",
  "license": "MIT",
  "author": "D.Tadpole",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "heddle": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dtadpole/heddle.git"
  },
  "homepage": "https://github.com/dtadpole/heddle",
  "bugs": {
    "url": "https://github.com/dtadpole/heddle/issues"
  },
  "keywords": [
    "cordis",
    "harness",
    "agent",
    "framework",
    "plugin"
  ],
  "scripts": {
    "build": "tsc && cp src/server/page.html dist/server/page.html && cp node_modules/dompurify/dist/purify.min.js dist/purify.min.js",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "start": "node src/cli.ts",
    "test": "node --test test/*.test.ts",
    "prepublishOnly": "npm run build",
    "verify:ui": "sh _verifiers_/70-workspaces-sessions/verify.sh",
    "verify:fast": "npm test && HEDDLE_VERIFY_UI=0 sh _verifiers_/70-workspaces-sessions/verify.sh --allow-skip"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.5",
    "@deepseek-ai/schemastery": "^3.18.4",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "js-yaml": "^4.3.2",
    "marked": "^18.1.0",
    "marked-highlight": "^2.2.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
